{
  "name": "@t-crossword/mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "prepare:books": "node ../../scripts/check-mobile-picture-books.mjs",
    "build": "pnpm run prepare:books && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "sync": "cap sync",
    "sync:android": "pnpm run build && cap sync android",
    "open:android": "cap open android",
    "android": "cap run android",
    "ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "^7.4.0",
    "@ionic/react": "^8.5.0",
    "@ionic/react-router": "^8.5.0",
    "@t-crossword/contracts": "workspace:*",
    "@t-crossword/core": "workspace:*",
    "@t-crossword/utils": "workspace:*",
    "ionicons": "^7.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "catalog:",
    "vite": "^6.3.5"
  }
}
