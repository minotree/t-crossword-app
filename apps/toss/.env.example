# API URL only. Certificates, tokens and service-role keys must never use VITE_.
VITE_TOSS_HINT_API_URL=https://your-project-ref.supabase.co/functions/v1/toss-hints

# Production banner group ID. Leave empty to hide ads; never use a test ID.
VITE_TOSS_BANNER_AD_GROUP_ID=

# Production interstitial group ID. Leave empty to skip full-screen ads.
VITE_TOSS_INTERSTITIAL_AD_GROUP_ID=

# Public HTTPS directory of reviewed MP3 assets. No tokens or keys. Include /word-audio/.
VITE_TOSS_WORD_AUDIO_BASE_URL=
