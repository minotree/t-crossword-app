{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @t-crossword/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/quiz", "destination": "/index.html" },
    { "source": "/word-bank", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
